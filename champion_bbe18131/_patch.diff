+        probs[:, 0] -= 1.0
+        g = (probs.reshape(-1) / B).astype(np.float32)
+        gV = np.zeros_like(self.V); gW = np.zeros_like(self.W)
+        np.add.at(gW, Xflat, g[:, None])
